# ===== Милдеттүү (Vercel'де) =====
# JWT кол тамгасы үчүн купуя ачкыч, кеминде 32 белги. Түзүү: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Биринчи администратор (база бош болгондо автоматтык түзүлөт)
ADMIN_EMAIL=admin@site.kg
ADMIN_PASSWORD=
# Сайттын толук дареги (OAuth жана Stripe кайтаруу шилтемелери үчүн), мис. https://mysite.vercel.app
APP_URL=

# ===== Туруктуу маалымат базасы (Vercel'де сунушталат) =====
# Upstash Redis (Vercel → Storage → Upstash Redis). Vercel KV_REST_API_URL/KV_REST_API_TOKEN да колдоого алынат.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Кошумча интеграциялар (бош калса — сайт иштейт, функция "туташкан эмес" деп көрсөтүлөт) =====
# Telegram бот: @BotFather'ден токен, chat_id — @userinfobot аркылуу
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Почта (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=ItaliaEdu <onboarding@resend.dev>
# Stripe (test режим: sk_test_...). Бош болсо — DEMO төлөм иштейт.
STRIPE_SECRET_KEY=
# Cloudinary (сүрөт жүктөө)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Google OAuth (console.cloud.google.com) — Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (github.com/settings/developers) — Callback URL: {APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
